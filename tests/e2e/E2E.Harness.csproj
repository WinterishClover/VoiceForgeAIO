<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>VoiceForgeAIO</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS8601;CS8618;CS8625</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../VoiceForgeAIO/**/*.cs" Exclude="../../VoiceForgeAIO/obj/**;../../VoiceForgeAIO/bin/**;../../VoiceForgeAIO/Program.cs;../../VoiceForgeAIO/Providers/TtsProviderRegistry.cs" />
    <Compile Include="Shim.cs;Host.cs;Registry.cs;PluginMaker.cs" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.53.1" />
  </ItemGroup>
</Project>
