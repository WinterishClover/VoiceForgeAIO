<Project>
  <!--
    Self-contained publish profile: bundles the .NET 8 runtime into the output
    folder so testers/users don't need it preinstalled. Use via Visual Studio's
    Publish dialog (pick "FolderProfile"), or from the command line:

      dotnet publish -c Release -p:PublishProfile=FolderProfile

    WebView2 is NOT bundled by this -- it's a native OS component, not a .NET
    runtime piece, so it can't be embedded this way. It's already installed on
    the vast majority of Windows 10/11 machines; see the installer script for
    a graceful check/install step for the rare case it's missing.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net8.0-windows\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Deliberately NOT using PublishSingleFile: this app loads wwwroot/index.html
         from disk at a relative path, so a wwwroot folder needs to ship alongside
         the exe either way -- a "single file" exe wouldn't actually simplify
         distribution here, just add single-file-extraction complexity for no gain. -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Trimming can break reflection-based JSON (de)serialization used throughout
         the provider/bridge code -- not worth the risk for the size savings. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
